# Datto RMM MCP Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials

# Required: Your Datto RMM API credentials
# Get these from your Datto RMM portal: User Profile → API Settings
DATTO_API_KEY=your-api-key-here
DATTO_API_SECRET=your-api-secret-here

# Optional: Datto RMM platform (default: merlot)
# Valid options: pinotage, merlot, concord, vidal, zinfandel, syrah, sandbox, devb, staging
DATTO_PLATFORM=merlot
